# Configure a server endpoint to store leads and trigger CRM, email and WhatsApp.
VITE_LEAD_ENDPOINT=https://app.persoocrm.online/api/webhooks/leads
# Token Bearer do webhook (em produção, prefira um proxy server-side para não expor segredos no navegador).
VITE_LEAD_AUTH_TOKEN=
# Public URL to your scheduling page.
VITE_DEMO_URL=
